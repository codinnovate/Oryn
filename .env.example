# ---- Application ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://oryn:oryn@127.0.0.1:54329/oryn

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Secrets (generate unique values per environment) ----
# 32-byte base64 key used for AES-256-GCM encryption of provider tokens at rest.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Secret used to sign OAuth state parameters and other short-lived tokens.
# Generate: openssl rand -base64 48
STATE_SECRET=

# ---- OAuth: Google / Gmail ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- OAuth: Microsoft / Outlook ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ---- AI provider (OpenAI-compatible) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Limits ----
ATTACHMENT_MAX_BYTES=26214400
EMAIL_BODY_MAX_BYTES=2097152

# ---- Workers ----
DISABLE_SYNC_WORKER=false
